  chapters:
  - title: "\u7B2C\u4E00\u7AE0"
    description: "\u57FA\u7840\u6559\u5B66\n\u65E0\u4E8B\u4EF6\n\u65E0\u590D\u5408\u5143\u7D20\n\u65E0\u5143\u7D20\u74F6"
    levels:
    - title: "\u7B2C 1 \u5173"
      goal: "\u76F8\u514B\u6559\u5B66"
    - title: "\u7B2C 2 \u5173"
      goal: "\u76F8\u751F\u6559\u5B66"
    - title: "\u7B2C 3 \u5173"
      goal: "\u573A\u4E0A\u53EA\u5269\u6C34\u5143\u7D20"
    - title: "\u7B2C 4 \u5173"
      goal: "\u573A\u4E0A\u53EA\u5269\u6C34\u548C\u706B"
    - title: "\u7B2C 5 \u5173"
      goal: "\u5E73\u5747\u5143\u7D20\n\u901A\u8FC7\u5173\u5361\u540E\uFF0C\u5C55\u793A\u5267\u60C5\u5E76\u5F15\u51FA\u4E0B\u4E00\u7AE0\u7684\u590D\u5408\u5143\u7D20"
  - title: "\u7B2C\u4E8C\u7AE0"
    description: "\u590D\u5408\u5143\u7D20\u6559\u5B66\n\u65E0\u74F6\u5B50\u4E8B\u4EF6"
    levels:
    - title: "\u7B2C 1 \u5173"
      goal: "\u5408\u6210\u6559\u5B66\n\u6210\u529F\u5408\u6210 1 \u4E2A\u590D\u5408\u5143\u7D20\uFF0C\u5E76\u8BA9\u573A\u4E0A\u53EA\u5269\u4E24\u79CD\u5143\u7D20"
    - title: "\u7B2C 2 \u5173"
      goal: "\u5206\u89E3\u6559\u5B66\n\u6210\u529F\u5206\u89E3 1 \u79CD\u590D\u5408\u5143\u7D20"
    - title: "\u7B2C 3 \u5173"
      goal: "\u6210\u529F\u5206\u89E3\u4E94\u79CD\u590D\u5408\u5143\u7D20"
    - title: "\u7B2C 4 \u5173"
      goal: "\u573A\u4E0A\u5408\u7406\u5229\u7528\u7075\u6CC9\uFF0C\u8BA9\u573A\u4E0A\u53EA\u5269\u4E0B\u6728\u5143\u7D20"
    - title: "\u7B2C 5 \u5173"
      goal: "\u672C\u56DE\u5408\u81F3\u5C11\u751F\u6210\u4E00\u79CD\u590D\u5408\u5143\u7D20\uFF0C\u8BA9\u573A\u4E0A\u5143\u7D20\u5E73\u5747\u5206\u5E03\n\u901A\u8FC7\u540E\u5F15\u51FA\u4E0B\u4E00\u7AE0\u7684\u5C0F\u74F6\u5B50"
  - title: "\u7B2C\u4E09\u7AE0"
    description: "\u5C0F\u74F6\u5B50\u6559\u5B66\n\u65E0\u4E8B\u4EF6"
    levels:
    - title: "\u7B2C 1 \u5173"
      goal: "\u5C0F\u74F6\u5B50\u6559\u5B66\n\u901A\u8FC7\u6761\u4EF6\uFF1A\u573A\u4E0A\u5143\u7D20\u53EA\u6709\u706B"
    - title: "\u7B2C 2 \u5173"
      goal: "\u8BA9\u5C0F\u74F6\u5B50\u751F\u6210\n20 \u5F20\u706B\u724C"
    - title: "\u7B2C 3 \u5173"
      goal: "\u8BA9\u5C0F\u74F6\u5B50\u751F\u6210\n10 \u5F20\u91D1\u724C\n10 \u5F20\u6728\u724C"
    - title: "\u7B2C 4 \u5173"
      goal: "\u8BA9\u5C0F\u74F6\u5B50\u751F\u6210\n7 \u6C34\u30016 \u571F\u30015
        \u706B"
    - title: "\u7B2C 5 \u5173"
      goal: "\u5E73\u5747\u6BCF\u79CD\u5C0F\u74F6\u5B50\u5404\u751F\u6210 5 \u5F20\u724C\n\u901A\u8FC7\u540E\u5C55\u793A\u5267\u60C5"
  - title: "\u7B2C\u56DB\u7AE0"
    description: "\u52A0\u5165\u4E8B\u4EF6\u724C"
    levels:
    - title: "\u7B2C 1 \u5173"
      goal: "\u53D1\u724C\u4E8B\u4EF6\n\u8FD0\u7528\u968F\u673A\u5206\u89E3\u4E24\u79CD\u590D\u5408\u5143\u7D20"
    - title: "\u7B2C 2 \u5173"
      goal: "\u56FA\u5B9A\u8303\u56F4\u4E8B\u4EF6\n\u5C0F\u74F6\u5B50\u751F\u6210\n3
        \u6C34\u30016 \u571F\u30015 \u706B\n4 \u91D1\u30012 \u6728\n\u6E38\u620F\u80DC\u5229"
    - title: "\u7B2C 3 \u5173"
      goal: "\u968F\u673A\u8303\u56F4\u4E8B\u4EF6\n\u573A\u4E0A\u53EA\u5269\u571F\u5143\u7D20"
    - title: "\u7B2C 4 \u5173"
      goal: "\u573A\u4E0A\u53EA\u5269\u91D1\u548C\u571F"
    - title: "\u7B2C 5 \u5173"
      goal: "\u5E73\u5747\u5143\u7D20\n\u901A\u8FC7\u5173\u5361"
